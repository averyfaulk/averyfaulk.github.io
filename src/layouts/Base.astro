---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Serialised into a ld+json script tag. Escaped defensively by the layout. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
// Astro.site is only defined when `site` is set in astro.config.mjs.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// `<` cannot appear raw: it would let a description close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <!-- `sticky` gives the bar a positioning context, so the logo and the
         pill both sit above the project cards' z-10 stretched-link rows. -->
    <header
      class="sticky top-0 z-50 border-b border-line-strong bg-elevated/80 backdrop-blur-md"
    >
      <div
        class="mx-auto flex w-full max-w-3xl items-center justify-between gap-3 px-6 py-3.5"
      >
        <!-- favicon.svg carries its own aria-label, so the image is decorative
             and the accessible name comes from the link. -->
        <a href="/" aria-label="Home" class="flex items-center">
          <img
            src="/favicon.svg"
            alt=""
            width="28"
            height="28"
            class="h-7 w-7 rounded-lg"
          />
        </a>
        <a
          href={site.links.github}
          rel="me noopener"
          class="inline-block rounded-full border border-line-strong px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent/50 hover:text-fg"
        >
          GitHub
        </a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex w-full max-w-3xl flex-col gap-1 px-6 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p>Built with Astro. No tracking, no client-side JavaScript.</p>
      </div>
    </footer>
  </body>
</html>
