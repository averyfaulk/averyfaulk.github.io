---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist.">
  <section class="py-10">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 max-w-prose leading-relaxed text-muted">
      That URL does not match anything here. It may have moved, or the link may be mistyped.
    </p>
    <a href="/" class="mt-8 inline-block font-medium text-accent hover:underline">
      ← Back to all projects
    </a>
  </section>
</Base>
