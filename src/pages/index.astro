---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { getProjectRelease } from '../lib/releases';

const featured = projects.filter((project) => project.featured).sort((a, b) => a.order - b.order);

// Memoised inside getProjectRelease, so this is one request per project.
const panels = new Map(
  await Promise.all(
    featured.map(async (project) => [project.slug, await getProjectRelease(project)] as const),
  ),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  sameAs: [site.links.github],
};
---

<Base jsonLd={jsonLd}>
  <section class="pb-14">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{site.name}</h1>
    <p class="mt-3 text-lg text-muted">{site.tagline}</p>
    <p class="mt-6 max-w-prose leading-relaxed text-fg/90">
      Side projects, mostly desktop apps and developer tools — built because the thing I wanted
      didn't exist yet.
    </p>
  </section>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="sr-only">Projects</h2>
    <div class="flex flex-col gap-6">
      {
        featured.map((project) => (
          <ProjectCard
            project={project}
            panel={panels.get(project.slug) ?? { release: null, updatedAt: null }}
          />
        ))
      }
    </div>
  </section>
</Base>
