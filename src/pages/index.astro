---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { getRelease } from '../lib/releases';

const featured = projects.filter((project) => project.featured).sort((a, b) => a.order - b.order);

// Memoised inside getRelease, so this is a single API request for the build.
const releases = new Map(
  await Promise.all(featured.map(async (project) => [project.slug, await getRelease(project)] as const)),
);
---

<Base>
  <section class="pb-14">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{site.name}</h1>
    <p class="mt-3 text-lg text-muted">{site.tagline}</p>
    <p class="mt-6 max-w-prose leading-relaxed text-fg/90">
      Side projects, mostly desktop apps and developer tools. Each one has its own page with the
      source and the latest downloadable build.
    </p>
  </section>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="sr-only">Projects</h2>
    <div class="flex flex-col gap-6">
      {featured.map((project) => <ProjectCard project={project} release={releases.get(project.slug) ?? null} />)}
    </div>
  </section>
</Base>
